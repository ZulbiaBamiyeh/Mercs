{
  "name": "mercs-engine",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Deterministic simultaneous-resolution tactics engine.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
